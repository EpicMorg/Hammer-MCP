# Cross-compile Windows PE on Linux: clang-cl + lld-link + MSVC CRT / Windows SDK splatted by xwin.
#   -DHMCP_ARCH=x86_64 | x86        -DXWIN_DIR=/opt/xwin (default)
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_VERSION 10.0)
if(NOT HMCP_ARCH)
  set(HMCP_ARCH x86_64)
endif()
if(NOT XWIN_DIR)
  set(XWIN_DIR /opt/xwin)
endif()
if(HMCP_ARCH STREQUAL "x86")
  set(CMAKE_SYSTEM_PROCESSOR X86)
  set(_triple i686-pc-windows-msvc)
else()
  set(CMAKE_SYSTEM_PROCESSOR AMD64)
  set(_triple x86_64-pc-windows-msvc)
endif()
find_program(CMAKE_C_COMPILER NAMES clang-cl clang-cl-19 PATHS /usr/lib/llvm-19/bin REQUIRED)
set(CMAKE_CXX_COMPILER ${CMAKE_C_COMPILER})
find_program(CMAKE_LINKER NAMES lld-link REQUIRED)
find_program(CMAKE_AR NAMES llvm-lib PATHS /usr/lib/llvm-19/bin REQUIRED)
find_program(CMAKE_RC_COMPILER NAMES llvm-rc PATHS /usr/lib/llvm-19/bin REQUIRED)
find_program(CMAKE_MT NAMES llvm-mt PATHS /usr/lib/llvm-19/bin)
set(CMAKE_C_COMPILER_TARGET ${_triple})
set(CMAKE_CXX_COMPILER_TARGET ${_triple})
set(_inc "--target=${_triple} /imsvc ${XWIN_DIR}/crt/include /imsvc ${XWIN_DIR}/sdk/include/ucrt /imsvc ${XWIN_DIR}/sdk/include/um /imsvc ${XWIN_DIR}/sdk/include/shared")
set(CMAKE_C_FLAGS_INIT "${_inc}")
set(CMAKE_CXX_FLAGS_INIT "${_inc} /EHsc")
set(CMAKE_RC_FLAGS_INIT "-I ${XWIN_DIR}/sdk/include/um -I ${XWIN_DIR}/sdk/include/shared")
set(_lib "/libpath:${XWIN_DIR}/crt/lib/${HMCP_ARCH} /libpath:${XWIN_DIR}/sdk/lib/um/${HMCP_ARCH} /libpath:${XWIN_DIR}/sdk/lib/ucrt/${HMCP_ARCH}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_lib}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_lib}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_lib}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
