<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>HammerMcp.App</RootNamespace>
    <AssemblyName>hammer-mcp</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>media\hammer-mcp-stopped.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="media\hammer-mcp-stopped.ico" />
    <EmbeddedResource Include="media\hammer-mcp-started.ico" LogicalName="hammer-mcp-started.ico" />
    <EmbeddedResource Include="media\hammer-mcp-stopped.ico" LogicalName="hammer-mcp-stopped.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HammerMcp.Server\HammerMcp.Server.csproj" />
  </ItemGroup>
  <!-- Advanced mode: injectors + adapter DLLs (built by CMake from src/native) go to native\ next to the app.
       Default: build/native-{Win32,x64}/Release of this repo; CI passes -p:HmcpNativeDir=<folder with both>. -->
  <PropertyGroup>
    <HmcpRepoRoot>$(MSBuildThisFileDirectory)..\..\..\</HmcpRepoRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(HmcpNativeDir)' == ''">
    <HmcpNative Include="$(HmcpRepoRoot)build\native-Win32\Release\hmcp-*.exe;$(HmcpRepoRoot)build\native-Win32\Release\hmcp-*.dll" />
    <HmcpNative Include="$(HmcpRepoRoot)build\native-x64\Release\hmcp-*.exe;$(HmcpRepoRoot)build\native-x64\Release\hmcp-*.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(HmcpNativeDir)' != ''">
    <HmcpNative Include="$(HmcpNativeDir)\**\hmcp-*.exe;$(HmcpNativeDir)\**\hmcp-*.dll" />
  </ItemGroup>
  <ItemGroup>
    <!-- real files on disk, never inside the single-file exe: the injector is started as a process and the adapter DLL
         is loaded by Hammer from its path -->
    <None Include="@(HmcpNative)" Link="native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
